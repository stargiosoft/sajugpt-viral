CREATE TABLE love_spot_results (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  section TEXT NOT NULL,         -- '3-1', '3-2', '3-3'
  content_key TEXT NOT NULL,     -- '재인', '식관', '하드인비', '식상' 등
  place TEXT NOT NULL,           -- 추천 장소 (예: '분위기 좋은 브런치 카페 · 프라이빗 쿠킹 클래스')
  place_desc TEXT NOT NULL,      -- 장소 한 줄 설명
  tip TEXT NOT NULL,             -- 거기선 이렇게 행동하세요
  image_slug TEXT NOT NULL,      -- public/love-spot/images/{image_slug}.png
  created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone('utc'::text, now()) NOT NULL,

  CONSTRAINT unique_love_spot_section_key UNIQUE (section, content_key)
);

ALTER TABLE love_spot_results ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Allow public read access"
ON public.love_spot_results
FOR SELECT
USING (true);

